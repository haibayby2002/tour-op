# Copy to .env. Everything is optional for local development:
# without DATABASE_URL/REDIS_URL the backend uses SQLite, an in-memory
# channel layer and runs Celery tasks inline.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string-of-at-least-32-chars
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
WEB_APP_URL=http://localhost:5173

# DATABASE_URL=postgres://tourops:tourops@localhost:5432/tourops
# REDIS_URL=redis://localhost:6379/0

# Verification
REQUIRE_CONTACT_VERIFICATION=true
EXPOSE_VERIFICATION_CODES=true
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# SMS_PROVIDER=apps.accounts.providers.ConsoleSmsProvider

# Sign in with Google (optional): the Web OAuth client ID from Google Cloud Console.
# GOOGLE_CLIENT_IDS=1234567890-abc.apps.googleusercontent.com

# Product rules
MAX_GROUP_SIZE=3
MIN_USER_AGE=18

# --- Uploaded files (photos, avatars, report evidence) ---------------------
# MEDIA_STORAGE picks where files live; nothing else in the code changes.
#   local  backend/media on disk (default)
#   s3     Amazon S3 or any S3-compatible service
#   r2     Cloudflare R2
# The database stores storage keys, not URLs, so switching later only needs
# the existing objects copied to the new bucket with the same keys.
MEDIA_STORAGE=local
# local only: let Django serve /media/ itself (defaults to DJANGO_DEBUG).
# Set true to run a small deployment on local disk before moving to R2/S3.
# SERVE_MEDIA=true

# s3 / r2:
# MEDIA_BUCKET=tourop-media              # public photos
# MEDIA_PRIVATE_BUCKET=tourop-private    # report evidence; no public access. If empty, uses MEDIA_BUCKET under private/
# MEDIA_ACCESS_KEY_ID=
# MEDIA_SECRET_ACCESS_KEY=
# MEDIA_PUBLIC_URL=https://media.tour-op.com   # CDN / custom domain / r2.dev URL. Empty = signed URLs
# MEDIA_URL_EXPIRE_SECONDS=3600           # lifetime of signed URLs
# r2 only:
# R2_ACCOUNT_ID=                          # endpoint becomes https://<id>.r2.cloudflarestorage.com
# s3 only:
# MEDIA_REGION=ap-southeast-1
# MEDIA_ENDPOINT_URL=                     # only for non-AWS S3-compatible services (MinIO, B2...)

# Image uploads are re-encoded to WebP (EXIF/GPS stripped, max 1600 px + a thumbnail).
IMAGE_MAX_UPLOAD_MB=10
IMAGE_QUALITY=82

# Push notifications via Expo
EXPO_PUSH_ENABLED=false

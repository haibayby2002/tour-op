# Leave empty in development: Vite proxies /api, /ws and /media to the backend.
# Set to the API origin (e.g. https://api.tour-op.com) for production builds.
VITE_API_URL=

# Sign in with Google: the Web OAuth client ID (same value as the backend's GOOGLE_CLIENT_IDS).
# The button is hidden when this is empty.
# VITE_GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com

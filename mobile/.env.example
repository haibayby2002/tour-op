# The app calls http://<machine running Metro>:<EXPO_PUBLIC_API_PORT> by default,
# which works for Expo Go on a phone on the same Wi-Fi.
#   8010 = backend in Docker (docker compose up)
#   8000 = backend via `python manage.py runserver 0.0.0.0:8000`
EXPO_PUBLIC_API_PORT=8010

# Or point at a deployed API (overrides the above):
# EXPO_PUBLIC_API_URL=https://api.tour-op.com

# Sign in with Google (development/production builds only; hidden in Expo Go):
# the *Web* OAuth client ID, the same value as the backend's GOOGLE_CLIENT_IDS.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=1234567890-abc.apps.googleusercontent.com

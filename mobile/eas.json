{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.tour-op.com",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "387470670849-actg78e70ulfohmcsiotvkp6vu419bc8.apps.googleusercontent.com"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.tour-op.com",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "387470670849-actg78e70ulfohmcsiotvkp6vu419bc8.apps.googleusercontent.com"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.tour-op.com",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "387470670849-actg78e70ulfohmcsiotvkp6vu419bc8.apps.googleusercontent.com"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./google-play-service-account.json",
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}

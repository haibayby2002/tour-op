# Copy to deploy.secrets.env (gitignored) and fill in. Delete it after deployment.

# Cloudflare R2 (dashboard: R2 > Manage R2 API Tokens > Create API token, permission "Object Read & Write")
R2_ACCOUNT_ID=
MEDIA_ACCESS_KEY_ID=
MEDIA_SECRET_ACCESS_KEY=

# Resend (resend.com > API Keys > Create, permission "Sending access")
RESEND_API_KEY=

# Production demo users + staff test account
DEMO_PASSWORD=
STAFF_TEST_EMAIL=
STAFF_TEST_PASSWORD=
